{
  "expo": {
    "name": "EsLatin",
    "slug": "eslatincsms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/eslatin-brand-white.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "eslatin",
    "splash": {
      "image": "./assets/eslatin-brand-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eslatin.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EsLatin necesita la cámara para escanear el código QR del cargador e iniciar la carga.",
        "NSLocationWhenInUseUsageDescription": "EsLatin usa tu ubicación para mostrar estaciones de carga cercanas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eslatin.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#07131E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/eslatin-brand-white.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "EsLatin necesita la cámara para escanear el código QR del cargador e iniciar la carga."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EsLatin usa tu ubicación para mostrar estaciones de carga cercanas."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "83c69667-e8c0-44a5-bf1d-7c8bfc0dada4"
      },
      "privacyPolicyUrl": "https://api.eslatin.com.co/legal/privacy.html",
      "termsOfServiceUrl": "https://api.eslatin.com.co/legal/terms.html",
      "supportEmail": "support@eslatin.com.co"
    },
    "owner": "amosrans-team"
  }
}
