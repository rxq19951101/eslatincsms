# Copiar a .env para desarrollo local: cp .env.example .env
#
# === EAS production secrets (no commitear valores reales) ===
# Crear en Expo dashboard o:
#   npx eas-cli@latest secret:create --scope project --name EXPO_PUBLIC_API_URL --value https://api.eslatin.com.co
#   npx eas-cli@latest secret:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <KEY>
#   npx eas-cli@latest secret:create --scope project --name EXPO_PUBLIC_PRIVACY_POLICY_URL --value https://api.eslatin.com.co/legal/privacy.html
#   npx eas-cli@latest secret:create --scope project --name EXPO_PUBLIC_TERMS_URL --value https://api.eslatin.com.co/legal/terms.html
# Gate / estado: app/store/P0_GATE_STATUS.txt
# Release:       app/scripts/eas-production-release.sh

# API (producción App Store: HTTPS obligatorio)
EXPO_PUBLIC_API_URL=https://api.eslatin.com.co

# 应用内三方支付轨（默认关闭；上架后再开）
EXPO_PUBLIC_PAYMENT_RAILS_ENABLED=false
EXPO_PUBLIC_MIN_BALANCE_COP=5000

# Mercado Pago (usar TEST- en sandbox, APP_USR- en producción)
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key
EXPO_PUBLIC_MERCADOPAGO_ENVIRONMENT=sandbox

# Wompi (Colombia)
EXPO_PUBLIC_WOMPI_PUBLIC_KEY_SANDBOX=pub_test_xxx
EXPO_PUBLIC_WOMPI_PUBLIC_KEY_PROD=pub_prod_xxx
EXPO_PUBLIC_WOMPI_ENVIRONMENT=sandbox

# Google Maps (restringir por bundle ID com.eslatin.app en Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Legal URLs (App Store Connect)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://api.eslatin.com.co/legal/privacy.html
EXPO_PUBLIC_TERMS_URL=https://api.eslatin.com.co/legal/terms.html

# Tenant por defecto (opcional)
EXPO_PUBLIC_TENANT_ID=
