{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:9000",
        "EXPO_PUBLIC_PAYMENT_RAILS_ENABLED": "false",
        "EXPO_PUBLIC_MERCADOPAGO_ENVIRONMENT": "sandbox"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PAYMENT_RAILS_ENABLED": "false",
        "EXPO_PUBLIC_MERCADOPAGO_ENVIRONMENT": "sandbox"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_PAYMENT_RAILS_ENABLED": "false",
        "EXPO_PUBLIC_MERCADOPAGO_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "support@eslatin.com.co",
        "ascAppId": "6790822403",
        "appleTeamId": "U3JDHH2G87"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
