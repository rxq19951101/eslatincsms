# Copy to .env.production on the server. Never commit the real file.
# Run: ./scripts/validate_prod_env.sh --first-boot

ENVIRONMENT=production

# Public DNS records must point to this server before startup.
ADMIN_DOMAIN=admin.eslatin.com.co
API_DOMAIN=api.eslatin.com.co
ACME_EMAIL=support@eslatin.com.co
PROXY_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

DB_USER=ocpp_prod
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_32_CHARS
DB_NAME=ocpp_prod
DATABASE_URL=postgresql://ocpp_prod:CHANGE_ME_DB_PASSWORD_URL_ENCODED@db:5432/ocpp_prod
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_CHARS
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_URL_ENCODED@redis:6379/0

SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ENCRYPTION_KEY=CHANGE_ME_STABLE_ENCRYPTION_KEY_AT_LEAST_32_CHARS
ENCRYPTION_SALT=CHANGE_ME_STABLE_RANDOM_SALT_AT_LEAST_16_CHARS

# Required only for the first empty-database startup. Remove after bootstrap.
CSMS_BOOTSTRAP_SUPER_ADMIN_EMAIL=support@eslatin.com.co
CSMS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CSMS_BOOTSTRAP_TENANT_ADMIN_EMAIL=amos.ran@eslatin.com.co
CSMS_BOOTSTRAP_TENANT_ADMIN_PASSWORD=

OCPP_WS_REQUIRE_PRE_REGISTERED=true
ENABLE_WEBSOCKET_TRANSPORT=true
ENABLE_MQTT_TRANSPORT=false
ENABLE_HTTP_TRANSPORT=false
ENABLE_DISTRIBUTED=false
SERVER_ID=
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_MAX_CONNECTIONS=1000
HEARTBEAT_PERSIST_INTERVAL_SECONDS=60
METER_PERSIST_INTERVAL_SECONDS=60
METER_REALTIME_TTL_SECONDS=86400
METER_DEDUPE_TTL_SECONDS=86400

CORS_ALLOW_ORIGINS=https://admin.eslatin.com.co
PUBLIC_API_BASE_URL=https://api.eslatin.com.co
NEXT_PUBLIC_CSMS_HTTP=https://api.eslatin.com.co
NEXT_PUBLIC_API_BASE_URL=https://api.eslatin.com.co
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=support@eslatin.com.co
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=support@eslatin.com.co
SMTP_TLS=false
SMTP_SSL=true

PAYMENT_RAILS_ENABLED=false
# Required before setting PAYMENT_RAILS_ENABLED=true. Never commit real values.
MERCADOPAGO_ENVIRONMENT=production
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Used only when MERCADOPAGO_ENVIRONMENT=sandbox; ignored in production.
MERCADOPAGO_SANDBOX_PAYER_EMAIL=test_payer@example.com
CHECKOUT_SESSION_TTL_SECONDS=900
# Dedicated Fernet key; generate separately from device ENCRYPTION_KEY.
PAYMENT_TOKEN_ENCRYPTION_KEY=
# Separate HMAC key for short-lived hosted-checkout URLs.
CHECKOUT_SIGNING_KEY=
CHECKOUT_RETURN_URL_ALLOWLIST=eslatin://payment-return
CHECKOUT_NEXT_ACTION_HOST_ALLOWLIST=mercadopago.com,mercadopago.com.co
WALLET_TOP_UP_MIN_AMOUNT=0.01
WALLET_TOP_UP_MAX_AMOUNT=99999999.99
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
ENABLE_METRICS=false
MONITORING_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_URL=None
REDOC_URL=None
