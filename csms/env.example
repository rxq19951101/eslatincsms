# 生产环境环境变量示例
# 复制此文件为 .env 并填写实际值

# ==================== 安全配置 ====================
# 加密密钥（32字节base64编码，用于加密master_secret）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here

# 加密Salt（16字节，用于PBKDF2）
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(16))"
ENCRYPTION_SALT=your-16-byte-salt-here

# JWT密钥（用于API认证）
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-jwt-secret-key-here

# 空数据库首次启动所需；必须显式设置，密码值不会写入日志。
# 已有管理员数据时不会使用这两个变量。
CSMS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CSMS_BOOTSTRAP_TENANT_ADMIN_PASSWORD=

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://ocpp_user:ocpp_password@localhost:5432/ocpp

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ==================== Redis配置 ====================
REDIS_URL=redis://host:port/db
REDIS_PASSWORD=

# ==================== MQTT配置 ====================
MQTT_BROKER_HOST=mqtt-broker-host
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ocpp

# ==================== 应用配置 ====================
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=9000

# 公网 HTTPS 域名（App 隐私政策 URL、支付 webhook 回调）
# PUBLIC_BASE_URL=https://api.eslatin.com.co

# ==================== CORS配置 ====================
# 支持 CORS_ORIGINS 或 CORS_ALLOW_ORIGINS（代码优先读取后者，两者等效）
CORS_ALLOW_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ==================== OCPP 安全 ====================
OCPP_WS_REQUIRE_PRE_REGISTERED=true
# New chargers receive a unique credential during Admin provisioning. The
# legacy OCPP_API_KEYS fallback is development-only and is rejected in production.
# OCPP_API_KEYS=legacy-development-key
# Production WebSocket connections are accepted only over WSS (or HTTPS from a
# trusted TLS reverse proxy that sets X-Forwarded-Proto).

# ==================== 钱包 ====================
ALLOW_MOCK_WALLET_TOP_UP=false

# ==================== 告警通知 / 用户邮件 ====================
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=ops@yourdomain.com
# 用户验证码、重置密码等事务邮件（不配则只写日志，验证码可在 CSMS 日志查看）
# Spaceship Spacemail 示例：
#   SMTP_HOST=mail.spacemail.com
#   SMTP_PORT=465
#   SMTP_SSL=true
#   SMTP_TLS=false
#   SMTP_USER=info@yourdomain.com
#   SMTP_PASSWORD=...
#   SMTP_FROM=info@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
# 验证邮件内链接的公网 API 根（隧道/生产）
PUBLIC_API_BASE_URL=https://api.eslatin.com.co

# ==================== 支付轨开关（默认关闭；上架后接三方时设为 true）====================
PAYMENT_RAILS_ENABLED=false
MIN_WALLET_BALANCE_TO_START=5000

# ==================== Wompi ====================
WOMPI_EVENTS_SECRET=your-wompi-events-secret

# ==================== 监控 ====================
MONITORING_INTERVAL_SECONDS=60
ENABLE_METRICS=false

# ==================== 传输配置 ====================
ENABLE_MQTT_TRANSPORT=true
ENABLE_HTTP_TRANSPORT=false
ENABLE_WEBSOCKET_TRANSPORT=false

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/csms/app.log

# ==================== API文档 ====================
# 生产环境建议设置为 None 禁用
DOCS_URL=None
REDOC_URL=None

# ==================== 监控配置 ====================
ENABLE_METRICS=true
METRICS_PATH=/metrics

# ==================== 速率限制 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ==================== Wompi 支付配置 ====================
# 环境：sandbox 或 production
WOMPI_ENVIRONMENT=sandbox

# Wompi API 基础URL（通常不需要手动设置，会根据环境自动选择）
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# Wompi 测试环境密钥（从 Wompi 文档获取）
WOMPI_PUBLIC_KEY_SANDBOX=pub_test_xxxxxxxxxx
WOMPI_PRIVATE_KEY_SANDBOX=prv_test_xxxxxxxxxx
WOMPI_INTEGRITY_SECRET=xxxxxxxxxx

# Wompi 生产环境密钥（生产环境部署时配置）
# WOMPI_PUBLIC_KEY_PROD=pub_prod_xxxxxxxxxx
# WOMPI_PRIVATE_KEY_PROD=prv_prod_xxxxxxxxxx

# Webhook URL（在 Wompi 后台配置）
# WOMPI_WEBHOOK_URL=https://your-domain.com/api/v1/app/wallet/payments/webhook

# ==================== Mercado Pago 支付配置 ====================
# 环境：sandbox（TEST- 凭证与官方测试卡）或 production（APP_USR）
MERCADOPAGO_ENVIRONMENT=sandbox

# Mercado Pago Access Token（后端 API）
MERCADOPAGO_ACCESS_TOKEN=TEST-ACCESS-TOKEN-PLACEHOLDER

# Mercado Pago Public Key（须与前端 card_tokens 使用的公钥一致）
MERCADOPAGO_PUBLIC_KEY=TEST-PUBLIC-KEY-PLACEHOLDER

MERCADOPAGO_APP_ID=TEST-APP-ID-PLACEHOLDER

MERCADOPAGO_CLIENT_SECRET=TEST-CLIENT-SECRET-PLACEHOLDER

# Mercado Pago Webhook Secret（用于验证 Webhook 签名）
# 在 Mercado Pago 后台配置 Webhook 时获取
MERCADOPAGO_WEBHOOK_SECRET=TEST-WEBHOOK-SECRET-PLACEHOLDER

# Webhook URL（在 Mercado Pago 后台配置）
# MERCADOPAGO_WEBHOOK_URL=https://your-domain.com/api/v1/app/wallet/payments/webhook-mp
