#
# 本文件为环境变量示例：用于本地开发配置。
# 复制为 .env 并根据需要调整（但不要提交 .env）。
#

# CSMS 服务配置
CSMS_PORT=9000
REDIS_URL=redis://localhost:6379/0

# Admin 前端配置
ADMIN_PORT=3000
NEXT_PUBLIC_CSMS_HTTP=http://localhost:9000
NEXT_PUBLIC_API_BASE_URL=http://localhost:9000
# Google Maps（Maps JavaScript API + Places，Docker / 生产构建时必须设置，否则地图与地址联想不可用）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Expo App（生产 App Store 构建 — 必须 HTTPS）
# EXPO_PUBLIC_API_URL=https://api.eslatin.com.co
# EXPO_PUBLIC_PAYMENT_RAILS_ENABLED=false
# Advanced Marker 用的地图 ID（可选；不填则使用 DEMO_MAP_ID）
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAP_ID=

# CSMS 支付轨（默认关闭；上架后接三方时改为 true）
# PAYMENT_RAILS_ENABLED=false
# MIN_WALLET_BALANCE_TO_START=5000

# PostgreSQL 数据库配置（暂未使用）
DB_PORT=5432
POSTGRES_USER=local
POSTGRES_PASSWORD=local
POSTGRES_DB=ocpp

# Redis 配置（暂未使用）
REDIS_PORT=6379
